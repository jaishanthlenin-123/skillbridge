# ==========================================
# SkillBridge Monorepo Configuration
# ==========================================

# Environment Mode
ENVIRONMENT=development
DEBUG=True

# Backend (Django)
DJANGO_SECRET_KEY=skillbridge-insecure-dev-secret-key-change-in-production-12345
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (PostgreSQL for prod/docker, SQLite fallback for quick local testing)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=skillbridge_db
DB_USER=skillbridge_user
DB_PASSWORD=skillbridge_password
DB_HOST=127.0.0.1
DB_PORT=5432

# ML Service Communication
ML_SERVICE_URL=http://127.0.0.1:8001
ML_SERVICE_INTERNAL_TOKEN=skillbridge-internal-secret-token-change-in-production
ML_SERVICE_TIMEOUT_SECONDS=30

# File Storage
PRIVATE_STORAGE_ROOT=./private_storage
MAX_UPLOAD_SIZE_BYTES=10485760

# ML Matching Engine Configuration
MATCHING_CONFIG_VERSION=1.0.0
MATCHING_WEIGHT_WEIGHTED_COVERAGE=0.45
MATCHING_WEIGHT_COVERAGE=0.35
MATCHING_WEIGHT_SEMANTIC=0.20
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# Frontend
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
