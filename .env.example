# ==========================================
# SkillBridge Monorepo Configuration Template
# ==========================================

# Environment Mode
ENVIRONMENT=development
DEBUG=True

# Backend (Django)
DJANGO_SECRET_KEY=skillbridge-insecure-dev-secret-key-change-in-production-12345
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Primary Relational Database (PostgreSQL)
DB_ENGINE=django.db.backends.postgresql
POSTGRES_DB=skillbridge
DB_NAME=skillbridge
POSTGRES_USER=skillbridge_user
DB_USER=skillbridge_user
POSTGRES_PASSWORD=your_strong_local_postgres_password
DB_PASSWORD=your_strong_local_postgres_password
POSTGRES_HOST=127.0.0.1
DB_HOST=127.0.0.1
POSTGRES_PORT=5432
DB_PORT=5432

# Document Database (MongoDB Atlas) - Chat logs & user feedback
# If left empty, chat and feedback logging operates in safe in-memory/degraded mode
MONGODB_URI=mongodb+srv://<atlas-username>:<atlas-password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=skillbridge

# Google Gemini API & LangChain Assistant Integration
# Obtain from Google AI Studio (https://aistudio.google.com/)
# If left empty, assistant uses deterministic PostgreSQL FAQ retrieval
GEMINI_API_KEY=your_gemini_api_key_here
# Note: Google sunset gemini-1.5-flash; recommended model is gemini-3.5-flash
GEMINI_MODEL=gemini-3.5-flash

# Third-Party Integrations (GitHub REST API)
# Optional personal access token to prevent rate-limiting on developer public insights
GITHUB_API_TOKEN=

# Internal ML Microservice (FastAPI + SentenceTransformers)
ML_SERVICE_URL=http://127.0.0.1:8001
ML_SERVICE_INTERNAL_TOKEN=skillbridge-internal-secret-token-change-in-production
ML_SERVICE_TIMEOUT_SECONDS=30

# Private Document Storage Root (Isolated from public static/media)
PRIVATE_STORAGE_ROOT=./private_storage
MAX_UPLOAD_SIZE_BYTES=10485760

# Hybrid Matching Engine Weights (Sum must equal 1.00)
MATCHING_CONFIG_VERSION=1.0.0
MATCHING_WEIGHT_WEIGHTED_COVERAGE=0.45
MATCHING_WEIGHT_COVERAGE=0.35
MATCHING_WEIGHT_SEMANTIC=0.20
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# Frontend
VITE_API_BASE_URL=http://127.0.0.1:8080/api/v1
